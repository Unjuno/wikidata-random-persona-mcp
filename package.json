{
  "name": "wikidata-random-persona-mcp",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Wikidata-live persona reference MCP with transparent catalog fallback and a Japanese discovery landing page.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node scripts/build-sites-worker.mjs && node --test test/*.test.mjs",
    "build:sites": "node scripts/build-sites-worker.mjs",
    "test:protocol": "node --test test/protocol.test.mjs",
    "check": "node scripts/check.mjs",
    "catalog:validate": "node scripts/validate-catalog.mjs",
    "catalog:refresh": "node scripts/refresh-catalog.mjs",
    "catalog:promote": "node scripts/promote-catalog.mjs",
    "catalog:sample-dump": "node scripts/sample-wikidata-dump.mjs",
    "catalog:bootstrap": "node scripts/bootstrap-wikidata.mjs --per-kind 150",
    "dev": "node scripts/preview-lp.mjs",
    "catalog:index-build": "node scripts/sample-wikidata-index.mjs",
    "catalog:index-promote": "node scripts/promote-persona-index.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  }
}
