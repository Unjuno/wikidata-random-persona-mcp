# Optional Node adapter. Sites mounts createApp().fetch from src/app.mjs, NOT the raw MCP handler.
PORT=3000
HOST=127.0.0.1
ALLOWED_HOSTS=127.0.0.1,localhost
# Full origins, not bare hosts. Empty denies any supplied Origin; no-Origin server clients remain allowed.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WIKIMEDIA_USER_AGENT=RandomPersonaMCP/0.2 (+https://github.com/Unjuno/wikidata-random-persona-mcp)
# Never put secrets in this committed example. Configure platform secrets separately if needed.
